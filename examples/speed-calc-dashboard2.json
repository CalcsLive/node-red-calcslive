  {
    "id": "d-unit",
    "type": "ui-template",
    "z": "tab-speed",
    "group": "grp-inputs",
    "name": "d Unit",
    "order": 2,
    "width": 6,
    "height": 1,
    "head": "",
    "format": "html",
    "storeOutMessages": false,
    "fwdInMessages": false,
    "resendOnRefresh": true,
    "templateScope": "local",
    "className": "",
    "template": "<template>\n  <div style=\"padding: 2px 0\">\n    <label style=\"font-size:0.75rem;color:#666;display:block;margin-bottom:2px\">d unit</label>\n    <input\n      type=\"text\"\n      list=\"d-unit-list\"\n      v-model=\"unit\"\n      @change=\"send({ payload: unit, topic: 'd_unit' })\"\n      placeholder=\"e.g. km\"\n      style=\"width:100%;padding:6px 8px;border:1px solid rgba(0,0,0,0.38);border-radius:4px;font-size:0.875rem;box-sizing:border-box\"\n    />\n    <datalist id=\"d-unit-list\">\n      <option value=\"km\" /><option value=\"m\" /><option value=\"mi\" />\n      <option value=\"ft\" /><option value=\"cm\" /><option value=\"mm\" />\n      <option value=\"yd\" /><option value=\"nm\" />\n    </datalist>\n  </div>\n</template>\n<script>\nexport default {\n  data() {\n    return { unit: 'km' }\n  }\n}\n</script>",
    "wires": [["store-d-unit"]]
  },

