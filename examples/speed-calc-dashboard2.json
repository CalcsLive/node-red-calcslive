  {
    "id": "build-req",
    "type": "function",
    "z": "tab-speed",
    "name": "Build CalcsLive Request",
    "func": "const d_value = flow.get('d_value') ?? 0;\nconst d_unit  = flow.get('d_unit')  ?? 'km';\nconst t_value = flow.get('t_value') ?? 0;\nconst t_unit  = flow.get('t_unit')  ?? 'h';\nconst v_unit  = flow.get('v_unit')  ?? 'm/s';\n\nmsg.articleId = '3M7ALBF4U-3BL';\nmsg.inputs = {\n    d: { value: parseFloat(d_value), unit: d_unit },\n    t: { value: parseFloat(t_value), unit: t_unit }\n};\nmsg.outputs = {\n    v: { unit: v_unit }\n};\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "wires": [["calcslive-calc"]]
  },

  {
    "id": "calcslive-calc",
    "type": "calcslive-calculate",
    "z": "tab-speed",
    "name": "Speed (d,t) => v",
    "configNodeId": "calcslive-cfg",
    "articleId": "3M7ALBF4U-3BL",
    "inputPQs": "",
    "outputPQs": "",
    "wires": [["format-result"]]
  },

  {
    "id": "calcslive-cfg",
    "type": "calcslive-config",
    "name": "CalcsLive",
    "baseUrl": "https://calcslive.com"
  },

  {
    "id": "err-catch",
    "type": "catch",
    "z": "tab-speed",
    "name": "Catch CalcsLive Errors",
    "scope": ["calcslive-calc"],
    "uncaught": false,
    "wires": [["format-error"]]
  },

  {
    "id": "format-error",
    "type": "function",
    "z": "tab-speed",
    "name": "Format Error",
    "func": "const err = msg.error || {};\nmsg.payload = '⚠ ' + (err.message || 'Calculation error');\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "wires": [["result-display"]]
  },

  {
    "id": "format-result",
    "type": "function",
    "z": "tab-speed",
    "name": "Format Result",
    "func": "if (msg.payload && msg.payload.v) {\n    const v = msg.payload.v;\n    const num = parseFloat(v.value);\n    // up to 6 sig figs, strip trailing zeros\n    const formatted = parseFloat(num.toPrecision(6)).toString();\n    msg.payload = formatted + ' ' + v.unit;\n} else {\n    msg.payload = '—';\n}\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "wires": [["result-display"]]
  }
]
