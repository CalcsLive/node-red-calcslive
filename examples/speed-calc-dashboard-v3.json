    {
        "id": "8e4a27b1e16ead59",
        "type": "function",
        "z": "4cc02e7f50a4d005",
        "name": "Build CalcsLive Request",
        "func": "const d_value = flow.get('d_value') ?? 0;\nconst d_unit  = flow.get('d_unit')  ?? 'km';\nconst t_value = flow.get('t_value') ?? 0;\nconst t_unit  = flow.get('t_unit')  ?? 'minute';\nconst v_unit  = flow.get('v_unit')  ?? 'm/s';\n\nmsg.articleId = '3M7ALBF4U-3BL';\nmsg.inputs = {\n    d: { value: parseFloat(d_value), unit: d_unit },\n    t: { value: parseFloat(t_value), unit: t_unit }\n};\nmsg.outputs = {\n    v: { unit: v_unit }\n};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 370,
        "y": 420,
        "wires": [
            [
                "acd4f0ca83de8ba4"
            ]
        ]
    },
