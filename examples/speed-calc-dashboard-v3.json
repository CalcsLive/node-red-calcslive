    {
        "id": "f169a3263cef43c6",
        "type": "function",
        "z": "4cc02e7f50a4d005",
        "name": "Format Result",
        "func": "if (msg.payload && msg.payload.v) {\n    const v = msg.payload.v;\n    const num = parseFloat(v.value);\n    // up to 6 sig figs, strip trailing zeros\n    const formatted = parseFloat(num.toPrecision(6)).toString();\n    msg.payload = formatted + ' ' + v.unit;\n} else {\n    msg.payload = '—';\n}\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 760,
        "y": 420,
        "wires": [
