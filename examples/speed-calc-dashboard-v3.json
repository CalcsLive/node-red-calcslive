    {
        "id": "91816b29bf9faa28",
        "type": "function",
        "z": "4cc02e7f50a4d005",
        "name": "Run Calculation in Form",
        "func": "const p = msg.payload || {};\n\nconst d = Number(p.d);\nconst t = Number(p.t);\n\nif (p.d === \"\" || p.d == null || !Number.isFinite(d) || d < 0) {\n    node.error(\"Enter a valid distance of zero or more.\", msg);\n    return null;\n}\n\nif (p.t === \"\" || p.t == null || !Number.isFinite(t) || t <= 0) {\n    node.error(\"Enter a time greater than zero.\", msg);\n    return null;\n}\n\nif (!p.d_unit || !p.t_unit || !p.v_unit) {\n    node.error(\"Select distance, time, and speed units.\", msg);\n    return null;\n}\n\nflow.set(\"d_value\", d);\nflow.set(\"d_unit\", p.d_unit);\nflow.set(\"t_value\", t);\nflow.set(\"t_unit\", p.t_unit);\nflow.set(\"v_unit\", p.v_unit);\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 350,
        "y": 620,
        "wires": [
            [
                "8e4a27b1e16ead59"
            ]
        ]
