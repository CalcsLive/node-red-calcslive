        "z": "speed-two-methods-demo",
        "name": "D: Validate article and JSON",
        "func": "try {\n const p=msg.payload || {};\n const article=String(p.articleId || '').trim();\n if(!article) throw new Error('Enter a CalcsLive Article ID.');\n const parse=(text,label)=>{try{return JSON.parse(text);}catch(e){throw new Error(label+': '+e.message);}};\n const inputs=parse(p.inputsJson,'Inputs JSON');\n const outputs=parse(p.outputsJson,'Outputs JSON');\n const obj=x=>x!==null && typeof x==='object' && !Array.isArray(x);\n if(!obj(inputs)||!obj(outputs)) throw new Error('Inputs and outputs must be JSON objects.');\n if(!Object.keys(outputs).length) throw new Error('Request at least one output for the gauge.');\n for(const [symbol,q] of Object.entries(inputs)) {\n if(!obj(q)||typeof q.value!=='number'||!Number.isFinite(q.value)||typeof q.unit!=='string') throw new Error('Input '+symbol+' needs a numeric value and unit string.');\n }\n for(const [symbol,q] of Object.entries(outputs)) {\n if(!obj(q)||typeof q.unit!=='string') throw new Error('Output '+symbol+' needs a unit string.');\n }\n msg.articleId=article;msg.inputs=inputs;msg.outputs=outputs;msg.gaugeSymbol=Object.keys(outputs)[0];return msg;\n} catch(e) {node.error(e.message,msg);return null;}",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
