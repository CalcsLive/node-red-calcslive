        "type": "function",
        "z": "speed-two-methods-demo",
        "name": "D: Output to gauge",
        "func": "const symbol=msg.gaugeSymbol || Object.keys(msg.outputs || {})[0];\nconst q=msg.payload && msg.payload[symbol];\nconst value=q && Number(q.value);\nif(!q || !Number.isFinite(value)){node.error('No numeric result returned for '+symbol,msg);return null;}\nconst span=Math.max(Math.abs(value)*1.5,1);\nconst gauge={...msg,payload:Number(value.toPrecision(6)),ui_update:{label:symbol==='v'?'Speed':symbol,units:q.unit || '',min:value<0?-span:0,max:value<0?0:span,segments:[{color:'#0094CE',from:value<0?-span:0}]}};\nconst status={...msg,payload:'Calculated: '+symbol+' = '+Number(value.toPrecision(6))+' '+(q.unit || '')};\nreturn [gauge,status];",
