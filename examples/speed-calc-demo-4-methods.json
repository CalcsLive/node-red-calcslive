    {
        "id": "speed-demo-parse-c",
        "type": "function",
        "z": "speed-two-methods-demo",
        "name": "C: Parse and validate JSON",
        "func": "try {\n    const p = msg.payload || {};\n    let inputs, outputs;\n    try { inputs = JSON.parse(p.inputsJson); }\n    catch (e) { throw new Error('Inputs JSON: ' + e.message); }\n    try { outputs = JSON.parse(p.outputsJson); }\n    catch (e) { throw new Error('Outputs JSON: ' + e.message); }\n    const object = x => x !== null && typeof x === 'object' && !Array.isArray(x);\n    if (!object(inputs) || !object(outputs)) throw new Error('Inputs and outputs must be JSON objects.');\n    for (const symbol of ['d', 't']) {\n        const q = inputs[symbol];\n        if (!object(q) || typeof q.value !== 'number' || !Number.isFinite(q.value) || typeof q.unit !== 'string' || !q.unit.trim())\n            throw new Error('Input ' + symbol + ' needs a numeric value and a unit string.');\n    }\n    if (inputs.d.value < 0 || inputs.t.value <= 0) throw new Error('Distance must be zero or more; time must be greater than zero.');\n    if (!object(outputs.v) || typeof outputs.v.unit !== 'string' || !outputs.v.unit.trim()) throw new Error('Output v needs a unit string.');\n    msg.inputs = inputs;\n    msg.outputs = outputs;\n    return msg;\n} catch (e) {\n    node.error(e.message, msg);\n    return null;\n}",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 440,
        "y": 680,
        "wires": [
