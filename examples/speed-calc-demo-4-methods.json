        "order": 1,
        "width": 12,
        "height": 0,
        "head": "",
        "format": "<template>\n<div class=\"pa-2\">\n<p class=\"mb-4\">Edit the JSON below, then run the same speed calculation.</p>\n<v-textarea v-model=\"inputsText\" label=\"Inputs JSON\" rows=\"7\" variant=\"outlined\" style=\"font-family:monospace\" spellcheck=\"false\"></v-textarea>\n<v-textarea v-model=\"outputsText\" label=\"Outputs JSON\" rows=\"4\" variant=\"outlined\" style=\"font-family:monospace\" spellcheck=\"false\"></v-textarea>\n<v-btn color=\"primary\" @click=\"send({payload:{inputsJson:inputsText,outputsJson:outputsText}})\">Run JSON</v-btn>\n</div>\n</template>\n<script>export default { data() { return { inputsText: JSON.stringify({d:{value:120,unit:'km'},t:{value:2,unit:'h'}},null,2), outputsText: JSON.stringify({v:{unit:'km/h'}},null,2) }; } }</script>",
        "storeOutMessages": false,
