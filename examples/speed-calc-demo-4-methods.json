    {
        "id": "speed-demo-build",
        "type": "function",
        "z": "speed-two-methods-demo",
        "name": "A: Build msg.inputs and msg.outputs",
        "func": "const p = msg.payload || {};\n\nconst d = Number(p.d);\nconst t = Number(p.t);\n\nif (p.d === \"\" || p.d == null || !Number.isFinite(d) || d < 0) {\n    node.error(\"Enter a valid distance of zero or more.\", msg);\n    return null;\n}\n\nif (p.t === \"\" || p.t == null || !Number.isFinite(t) || t <= 0) {\n    node.error(\"Enter a time greater than zero.\", msg);\n    return null;\n}\n\nif (!p.d_unit || !p.t_unit || !p.v_unit) {\n    node.error(\"Select distance, time, and speed units.\", msg);\n    return null;\n}\n\nmsg.inputs = { d: { value: d, unit: p.d_unit }, t: { value: t, unit: p.t_unit } };\nmsg.outputs = { v: { unit: p.v_unit } };\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 470,
        "y": 160,
        "wires": [
